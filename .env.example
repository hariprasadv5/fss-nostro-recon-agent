Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy RemoteSigned# Copy to .env and fill in. Without OPENAI_API_KEY the agent runs fully offline (mock LLM).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=auto          # auto | openai | mock
LLM_TEMPERATURE=0
RETRIEVER=auto             # auto | chroma | tfidf
RAG_TOP_K=3

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fss-nostro-recon-agent

# Control limits (POL-NR-03)
AMOUNT_TOLERANCE=1.00
FUZZY_REF_THRESHOLD=0.60
AUTO_ACTION_MAX_AMOUNT=250
AUTO_ACTION_MIN_CONFIDENCE=0.90
ESCALATION_AMOUNT=1000000

# REST API webhook security: callers of POST /webhooks/statement must send this in X-Webhook-Token
WEBHOOK_TOKEN=change-me
